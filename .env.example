# Utsavvy environment variables (IMPLEMENTATION_PLAN.md section 4.11).
# Copy to .env.local for Next.js. Never commit values: .env.local is gitignored.
# Variables marked "Convex" are set on each Convex deployment with
# `bunx convex env set NAME value` (or as project defaults in the dashboard),
# not in .env.local. Variables marked "CI" are GitHub Actions secrets.

# --- Next.js ---------------------------------------------------------------

# Convex client URL. `convex dev` writes CONVEX_URL; next.config.ts falls back to it.
NEXT_PUBLIC_CONVEX_URL=
# The Convex deployment `convex dev` pushes to, written by `convex dev`.
CONVEX_DEPLOYMENT=
# Clerk publishable key (development instance).
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
# Clerk secret key (development instance). Server only.
CLERK_SECRET_KEY=
# Browser key for the Google places sheet (S20), restricted by website and API. Setup: docs/setup/google-cloud.md.
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=
# Map ID for Google's map in the Google places sheet (Advanced Markers need one). Not secret.
NEXT_PUBLIC_GOOGLE_MAPS_MAP_ID=
# Optional, leave empty: the Vendor map then uses Utsavvy's own style over OpenFreeMap tiles (section 7.5).
NEXT_PUBLIC_MAP_STYLE_URL=
# The "Report content" address shown in the footer.
NEXT_PUBLIC_REPORT_EMAIL=

# --- Vercel ----------------------------------------------------------------

# Convex deploy key used by `bunx convex deploy` in the Vercel build (production key and preview key per environment).
CONVEX_DEPLOY_KEY=

# --- Convex (set with `bunx convex env set`, not here) ---------------------

# Clerk Frontend API URL; convex/auth.config.ts uses it as the issuer domain.
CLERK_FRONTEND_API_URL=
# Anthropic key: default model, helper model, Chat web search and Estimate research.
ANTHROPIC_API_KEY=
# Google Gemini key: the automatic fallback model when Claude can't answer.
GOOGLE_GENERATIVE_AI_API_KEY=
# Default model, claude-sonnet-5-5 (switch to gemini-3.8-flash without a deploy).
DEFAULT_MODEL=
# Helper model, claude-haiku-5-5.
HELPER_MODEL=
# Optional, default gemini-3.8-flash: the model a call falls back to by itself when Claude can't answer.
FALLBACK_MODEL=
# Geoapify key: geocoding an Event's city and the starter set.
GEOAPIFY_API_KEY=
# Clerk user IDs the demo reset gives the Owner, Member and Viewer roles (S19a).
DEMO_JUDGE_OWNER_ID=
DEMO_JUDGE_MEMBER_ID=
DEMO_JUDGE_VIEWER_ID=

# --- CI (GitHub Actions secrets) -------------------------------------------

# The e2e test user (a +clerk_test address). Tests sign it in with a sign-in
# ticket made from CLERK_SECRET_KEY, so no password is needed.
E2E_CLERK_USER_EMAIL=
# The deployment the browser tests run against; the PR's Vercel preview URL in CI.
PLAYWRIGHT_BASE_URL=
# Vercel's protection bypass for automation, sent as the x-vercel-protection-bypass header.
VERCEL_AUTOMATION_BYPASS_SECRET=

# --- Later stage (X1, X3) --------------------------------------------------

# Serper search for Discovery (X1, Convex).
SERPER_API_KEY=
# 32-byte secret for encrypting Event keys (X3a, Convex).
EVENT_KEY_SECRET=
# Sah-Nikhil's Google key for the second seeded Event (X3, Convex).
DEMO_GOOGLE_EVENT_KEY=
